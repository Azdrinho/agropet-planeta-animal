# Copie para .env (no seu computador). Na Vercel, cadastre estas variáveis em Settings > Environment Variables.

# Banco Turso. Sem estas duas, o site usa o arquivo local data/loja.db.
TURSO_DATABASE_URL=libsql://seu-banco-seu-usuario.turso.io
TURSO_AUTH_TOKEN=

# Fotos no Vercel Blob. A Vercel cria esta variável sozinha quando você conecta o Blob ao projeto.
# Sem ela, as fotos vão para a pasta local uploads/.
BLOB_READ_WRITE_TOKEN=

# Só para rodar no computador
PORT=3000
HOST=127.0.0.1
